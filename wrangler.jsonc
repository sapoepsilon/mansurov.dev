{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "mansurov-dev",
	"compatibility_date": "2026-06-01",
	"compatibility_flags": ["nodejs_compat"],
	"main": ".svelte-kit/cloudflare/_worker.js",
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},
	// R2 bucket that already holds the images. bucket_name must match the real
	// bucket in your personal Cloudflare account before `wrangler deploy`.
	"r2_buckets": [
		{
			"binding": "BUCKET",
			"bucket_name": "mansurov"
		}
	],
	// Contact form sends only to your inbox; verify this address in Email Routing.
	"send_email": [
		{
			"name": "CONTACT_EMAIL",
			"destination_address": "ismatulla@mansurov.dev"
		}
	]
}
